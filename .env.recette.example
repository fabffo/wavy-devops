# Exemple de configuration Docker recette pour Wavy
# Copiez ce fichier en .env.recette et adaptez les valeurs avant usage.

COMPOSE_PROJECT_NAME=wavy-recette

WAVY_SOCLE_DB_HOST_PORT=25432
WAVY_TIERS_DB_HOST_PORT=25433
WAVY_CONTRATS_DB_HOST_PORT=25434
WAVY_FACTURES_DB_HOST_PORT=25435

WAVY_SOCLE_DB_NAME=wavy_socle_db
WAVY_SOCLE_DB_USERNAME=socle_user
WAVY_SOCLE_DB_PASSWORD=motdepasse_recette

WAVY_TIERS_DB_NAME=wavy_tiers_db
WAVY_TIERS_DB_USER=tiers_user
WAVY_TIERS_DB_PASSWORD=motdepasse_recette

WAVY_CONTRATS_DB_NAME=wavy_contrats_db
WAVY_CONTRATS_DB_USER=contrats_user
WAVY_CONTRATS_DB_PASSWORD=motdepasse_recette

WAVY_FACTURES_DB_NAME=wavy_factures_db
WAVY_FACTURES_DB_USER=factures_user
WAVY_FACTURES_DB_PASSWORD=motdepasse_recette

WAVY_SOCLE_API_HOST_PORT=28080
WAVY_TIERS_API_HOST_PORT=28081
WAVY_CONTRATS_API_HOST_PORT=28082
WAVY_FACTURES_API_HOST_PORT=28083
WAVY_GATEWAY_HOST_PORT=28088

WAVY_SOCLE_FRONT_HOST_PORT=24200
WAVY_TIERS_FRONT_HOST_PORT=24201
WAVY_CONTRATS_FRONT_HOST_PORT=24202
WAVY_FACTURES_FRONT_HOST_PORT=24203

WAVY_SOCLE_SPRING_PROFILES_ACTIVE=local
WAVY_TIERS_SPRING_PROFILES_ACTIVE=local
WAVY_CONTRATS_SPRING_PROFILES_ACTIVE=recette
WAVY_FACTURES_SPRING_PROFILES_ACTIVE=recette
WAVY_GATEWAY_SPRING_PROFILES_ACTIVE=recette
