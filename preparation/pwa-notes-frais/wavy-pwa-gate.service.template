# CANDIDAT : remplacer les deux chemins/compte pendant la revue de promotion, jamais envsubst aveugle.
[Unit]
Description=Wavy PWA fail-closed authorization gate (host, independent of ERP Shell)
After=network.target

[Service]
User=__DEVOPS_OPERATOR__
WorkingDirectory=__DEVOPS_ROOT__
ExecStart=/usr/bin/python3 __DEVOPS_ROOT__/preparation/pwa-notes-frais/scripts/edge_gate.py
Restart=always
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=-__DEVOPS_ROOT__/deployments/pwa-release

[Install]
WantedBy=multi-user.target
