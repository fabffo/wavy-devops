# Copier vers .env.preprod (ignoré par Git) et remplacer toutes les valeurs CHANGE_ME.
COMPOSE_PROJECT_NAME=wavy-preprod
WAVY_IMAGE_REGISTRY=registry.example.com/wavy
WAVY_IMAGE_TAG=CHANGE_ME_GIT_SHA_OR_VERSION
WAVY_PUBLIC_HTTPS_PORT=24443
WAVY_PUBLIC_URL=https://preprod.example.com
WAVY_CORS_ALLOWED_ORIGIN_PATTERNS=https://preprod.example.com

WAVY_SOCLE_DB_NAME=wavy_socle_db
WAVY_SOCLE_DB_USERNAME=socle_user
WAVY_SOCLE_DB_PASSWORD=CHANGE_ME
WAVY_TIERS_DB_NAME=wavy_tiers_db
WAVY_TIERS_DB_USER=tiers_user
WAVY_TIERS_DB_PASSWORD=CHANGE_ME
WAVY_CONTRATS_DB_NAME=wavy_contrats_db
WAVY_CONTRATS_DB_USER=contrats_user
WAVY_CONTRATS_DB_PASSWORD=CHANGE_ME
WAVY_FACTURES_DB_NAME=wavy_factures_db
WAVY_FACTURES_DB_USER=factures_user
WAVY_FACTURES_DB_PASSWORD=CHANGE_ME
WAVY_TRESORERIE_DB_NAME=wavy_tresorerie_db
WAVY_TRESORERIE_DB_USER=tresorerie_user
WAVY_TRESORERIE_DB_PASSWORD=CHANGE_ME

# Bootstrap idempotent côté Socle : ces secrets ne doivent jamais être commités.
WAVY_BOOTSTRAP_TENANT_CODE=initial
WAVY_BOOTSTRAP_TENANT_NAME=Wavy Initial
WAVY_BOOTSTRAP_COMPANY_NAME=Société initiale
WAVY_BOOTSTRAP_COMPANY_SIREN=CHANGE_ME_9_DIGITS
WAVY_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
WAVY_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
WAVY_SESSION_SECRET=CHANGE_ME
WAVY_AI_PROVIDER=anthropic
WAVY_AI_MODEL=
WAVY_AI_API_KEY=
WAVY_EMAIL_HOST=
WAVY_EMAIL_PORT=587
WAVY_EMAIL_USERNAME=
WAVY_EMAIL_PASSWORD=
WAVY_LOG_LEVEL=INFO
WAVY_BACKUP_RETENTION_DAYS=30
WAVY_BACKUP_ENCRYPTION_PASSPHRASE=CHANGE_ME
